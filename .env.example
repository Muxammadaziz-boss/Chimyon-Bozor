# ==========================================
# CHIMYON-BOZOR PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. Django Core
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# 2. Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=600

# 3. Media Storage (Supabase S3-compatible Storage)
USE_S3_STORAGE=True
AWS_ACCESS_KEY_ID=your-supabase-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-storage-secret-access-key
AWS_STORAGE_BUCKET_NAME=chimyon-bozor-media
AWS_S3_ENDPOINT_URL=https://yourprojectid.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=auto

# 4. Security Headers (HTTPS & Cookies)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# 5. SMS Gateway (Optional)
SMS_GATEWAY_URL=https://otp-docs.web.app/api/send
SMS_API_KEY=your-sms-api-key
